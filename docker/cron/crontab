# docker/cron/crontab (system crontab format)
# 時刻はコンテナのタイムゾーン（TZ=Asia/Tokyo）
# 注意: 最終行も必ず改行で終えること（改行のない最終行は cronie に読み込まれない）

# cron のジョブはコンテナの環境変数を引き継がないため、run-cron.sh が書き出した値を
# bash スクリプトの起動時に読み込ませる（API_BASE_URL, WBS_SYNC_IDS 等）
BASH_ENV=/etc/cron.env

# 6時間ごとに通知チェックを実行
0 */6 * * * root /usr/local/bin/run-notification-check.sh

# 毎日午前2時にクリーンアップ
0 2 * * * root /usr/local/bin/run-cleanup.sh

# 毎時0分にヘルスチェック
0 * * * * root /usr/local/bin/health-check.sh

# 毎日午前0時にログローテーション
0 0 * * * root find /var/log/cron -name '*.log' -mtime +7 -delete

# 毎分、保留中（PENDING）のインポートジョブがあれば実行トリガー
* * * * * root /usr/local/bin/run-pending-import-jobs.sh

# 毎日午前3時にWBSインポートを実行（対象は WBS_SYNC_IDS）
0 3 * * * root /usr/local/bin/run-wbs-import.sh

# 毎月1日午前4時にGeppoインポートを実行（前月分）
0 4 1 * * root /usr/local/bin/run-geppo-import.sh
